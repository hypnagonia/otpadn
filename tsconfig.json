{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable",
      "WebWorker"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "vite/client"
    ],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/drumproducer",
    "src/partproducer"
  ]
}